# Base de datos
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookmarks?schema=public"

# Servidor
PORT=3333
HOST=0.0.0.0
NODE_ENV=development

# Secretos (genera uno con: openssl rand -hex 32)
JWT_SECRET="your_long_random_secret_here"
COOKIE_SECRET="your_other_long_random_secret_here"

# URLs
API_URL="http://localhost:3333"
FRONTEND_URL="http://localhost:5173"

# Google OAuth -> https://console.cloud.google.com/apis/credentials
# Redirect URI autorizada: http://localhost:3333/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub OAuth -> https://github.com/settings/developers
# Authorization callback URL: http://localhost:3333/api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""